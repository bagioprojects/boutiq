# FK Butik Nginx Reverse Proxy Konfigürasyonu
# /etc/nginx/sites-available/fkbutik.conf

server {
    listen 80;
    server_name fkbutik.com www.fkbutik.com; # Buraya kendi domaininizi yazınız

    # Let's Encrypt SSL doğrulaması
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # HTTPS yönlendirmesi (SSL sertifikası aldıktan sonra aktif ediniz)
    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Zaman aşımı limitleri
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Next.js statik dosyaları için önbellek optimizasyonu
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Resim ve medya dosyaları
    location /images/ {
        proxy_pass http://127.0.0.1:3000;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}

