# ========================================================
# FK BUTIK E-COMMERCE ORTAM DEĞİŞKENLERİ
# ========================================================

# Sunucu Portu (Varsayılan: 3000)
PORT=3000

# Ortam Modu (production / development)
NODE_ENV=production

# Güvenlik & JWT Oturum Anahtarı (En az 32 karakter güçlü rastgele bir dize)
JWT_SECRET=fkbutik-super-secret-jwt-token-key-2026-production

# SQLite Veritabanı Yolu (Opsiyonel - Özel bir dizinde tutmak isterseniz belirtin)
# DATABASE_PATH=./public/data/fkbutik.db
